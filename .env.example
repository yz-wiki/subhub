# ── 对外访问地址 ──────────────────────────────────────────────
# 用于生成订阅链接 / 二维码 / Surge MANAGED-CONFIG。
# 内网直接用 http://<机器IP>:<端口>；域名反代写 https://sub.example.com
PUBLIC_BASE=http://192.168.1.10:8080

# 网关映射到宿主机的端口
GATEWAY_PORT=8080

# 镜像名（compose 构建 / 拉取使用）
SUBHUB_IMAGE=subhub/subhub:latest

# 转换引擎
# 单服务模式（docker-compose.yml）：外部 subconverter 地址
# 完整链路（docker-compose.full.yml）会覆盖为 http://subconverter:25500
SUBCONVERTER=http://host.docker.internal:25500
SUBCONVERTER_IMAGE=asdlokj1qpi23/subconverter:latest

# 持久化目录在宿主机上的根路径，仅用于日志提示
CONFIG_HOST_ROOT=./data

# 兜底管理凭据：供脚本调用 /api 写接口（网页端账号登录不需要）
# 生成：openssl rand -hex 16
ADMIN_KEY=

# 上游转换结果缓存秒数（0 = 不缓存）
CACHE_TTL=300

# 单次转换超时毫秒。full 模板首次可能抓取 20+ 远程规则集
ENGINE_TIMEOUT=120000

# 是否允许内网/回环地址作为订阅源（默认 false，防 SSRF）
ALLOW_PRIVATE_SOURCES=false

# 反向代理后设为 true，读取 X-Forwarded-For
TRUST_PROXY=false

# 匿名转换 / 临时链接每分钟上限（登录用户与 ADMIN_KEY 不受限）
RATE_CONVERT=30

# 匿名订阅请求每分钟上限
RATE_SUBSCRIBE=120

# 子路径部署时的前缀，例如 /subhub（留空为根路径）
SUBHUB_BASE_PATH=

# 前端构建 npm 源（仅镜像构建阶段）
NPM_REGISTRY=https://registry.npmjs.org

# 容器时区
TZ=Asia/Shanghai
